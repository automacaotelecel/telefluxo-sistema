generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Task {
  id        String   @id
  title     String
  user      String
  status    String
  priority  String
  deadline  String
  source    String?
  createdAt DateTime @default(now())

  // === HIERARQUIA (PAI E FILHO) ===
  parentId String?
  parent   Task?   @relation("TaskHierarchy", fields: [parentId], references: [id])
  subTasks Task[]  @relation("TaskHierarchy")
  // ================================

  history TaskHistory[]
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    String
  text      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  User User @relation(fields: [userId], references: [id])
}

model AgendaEvent {
  id        String  @id @default(uuid())
  userId    String
  title     String
  date      String
  completed Boolean @default(false)

  User User @relation(fields: [userId], references: [id])
}

model TaskHistory {
  id       Int     @id @default(autoincrement())
  text     String
  user     String
  date     String
  type     String
  taskId   String
  fileUrl  String?
  fileName String?

  Task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model Announcement {
  id        String   @id @default(uuid())
  title     String
  content   String
  author    String
  priority  String   @default("Normal")
  category  String   @default("Aviso")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model DeptMessage {
  id         String   @id @default(uuid())
  content    String
  author     String
  department String
  createdAt  DateTime @default(now())
}

model Finance {
  id          String   @id @default(uuid())
  supplier    String
  description String
  category    String
  unit        String
  payer       String?
  value       Float
  issueDate   DateTime
  dueDate     DateTime
  status      String   @default("PENDENTE")

  // Campos de Inteligência (Recorrência)
  isRecurring        Boolean @default(false)
  totalInstallments  Int     @default(1)
  currentInstallment Int     @default(1)
  groupId            String?
  type               String  @default("EXPENSE")

  createdAt DateTime @default(now())
}

model Stock {
  id              String   @id @default(uuid())
  cnpj            String
  storeName       String
  productCode     String
  reference       String
  description     String
  category        String
  quantity        Float
  costPrice       Float
  salePrice       Float
  averageCost     Float
  acquisitionCost Float?
  updatedAt       DateTime @updatedAt
  serial          String?
  emLinha         String?
  cluster         String?
  stockType       String   @default("ESTOQUE")

  @@index([serial])
  @@index([storeName, productCode, stockType])
}

model User {
  id            String  @id @default(uuid())
  name          String
  email         String  @unique
  password      String
  role          String
  department    String
  allowedStores String?
  isAdmin       Boolean @default(false)
  status        String  @default("active")
  managerId     String?
  operation     String?

  AgendaEvent  AgendaEvent[]
  Notification Notification[]

  manager User?  @relation("ManagerStaff", fields: [managerId], references: [id])
  staff   User[] @relation("ManagerStaff")
}

model PriceTable {
  id       String @id @default(uuid())
  category String

  // Dados Principais (Tela)
  vigencia String?
  model    String
  price    String

  // Dados Complementares (Subtela)
  reference   String?
  priceSSG    String?
  descTelecel String?
  rebate      String?
  tradeIn     String?
  bogo        String?
  sip         String?
  price18x    String?

  // Controle
  columnM   String?
  highlight Boolean  @default(false)
  updatedAt DateTime @default(now())
}

// Tabela de Rastreabilidade (O Filme do IMEI)
model ImeiHistory {
  id               String   @id @default(uuid())
  serial           String   @unique
  productCode      String
  description      String
  currentStore     String
  entryDateCompany DateTime @default(now())
  entryDateStore   DateTime @default(now())
  transferCount    Int      @default(0)
  updatedAt        DateTime @updatedAt

  acquisitionCost   Float?
  acquisitionDate   DateTime?
  acquisitionCnpj   String?
  sourceTransaction String?
  sourceIdentifier  String?
  sourceDocument    String?
  costSource        String?
  costResolvedAt    DateTime?
}

model RhCollaborator {
  id        String       @id @default(uuid())
  name      String
  storeName String
  active    Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  documents RhDocument[]

  @@unique([name, storeName])
  @@index([storeName])
}

model RhDocument {
  id             String   @id @default(uuid())
  collaboratorId String
  documentType   String
  fileName       String
  originalName   String?
  filePath       String
  fileUrl        String
  mimeType       String?
  sizeBytes      Int?
  uploadedById   String?
  uploadedByName String?
  uploadedAt     DateTime @default(now())
  status         String   @default("VALIDADO")

  collaborator RhCollaborator @relation(fields: [collaboratorId], references: [id], onDelete: Cascade)

  @@unique([collaboratorId, documentType])
  @@index([documentType])
  @@index([uploadedAt])
}

// ============================================================
// BIPADOR DE APARELHOS / AUDITORIA DE ESTOQUE
// ============================================================

model InventoryAuditSession {
  id              String    @id @default(uuid())
  userId          String
  operatorName    String
  storeName       String
  status          String    @default("ACTIVE")
  expectedCount   Int       @default(0)
  sourceUpdatedAt DateTime?
  startedAt       DateTime  @default(now())
  completedAt     DateTime?
  updatedAt       DateTime  @updatedAt

  expectedItems InventoryAuditExpectedItem[]
  scans         InventoryAuditScan[]

  @@index([userId, storeName, status])
  @@index([storeName, startedAt])
}

model InventoryAuditExpectedItem {
  id          String    @id @default(uuid())
  sessionId   String
  stockId     String?
  imei        String
  productCode String
  reference   String
  description String
  category    String
  checkedAt   DateTime?
  createdAt   DateTime  @default(now())

  session InventoryAuditSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, imei])
  @@index([sessionId, checkedAt])
  @@index([imei])
}

model InventoryAuditScan {
  id          String   @id @default(uuid())
  sessionId   String
  imei        String
  rawValue    String
  result      String
  source      String   @default("MANUAL")
  productCode String?
  reference   String?
  description String?
  foundStore  String?
  createdAt   DateTime @default(now())

  session InventoryAuditSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@index([sessionId, result])
  @@index([imei])
}
